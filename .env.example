# ==========================================
# Anveshak - Global Environment Template (.env.example)
# Copy this file to .env at project root and fill in your values.
# ==========================================

# Database & PostgreSQL Configuration
# SPRING_DATASOURCE_* is whatever database the app actually connects to (local
# docker Postgres by default here, or point it at a remote DB like Neon).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5436/anveshak_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password

# Local Docker Postgres container's own admin login (docker-compose "postgres"
# service only). Independent of SPRING_DATASOURCE_* above - only applied the
# first time the ./docker-data/postgres volume is initialized.
POSTGRES_DB=anveshak_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# Mail Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_app_password
APP_MAIL_FROM=no-reply@anveshak.com

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Supabase Storage Configuration
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_BUCKET_NAME=anveshak
SUPABASE_ACCESS_KEY=your_supabase_anon_key
SUPABASE_SECRET_ACCESS_KEY=your_supabase_secret_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT Authentication
JWT_SECRET=your_base64_encoded_32_byte_secret_key
JWT_EXPIRATION=3600000
JWT_PRIVATE_KEY_FILE=/path/to/private.pem
JWT_PUBLIC_KEY_FILE=/path/to/public.pem

# AI & External Services
GEMINI_API_KEY=your_google_gemini_api_key
EMBEDDING_SERVICE_URL=http://localhost:8001
MODEL_NAME=all-MiniLM-L6-v2

# Base URLs
APP_BASE_URL=http://localhost:8080
ARXIV_BASE_URL=https://oaipmh.arxiv.org/oai
ARXIV_PAPER_BASE_URL=https://arxiv.org/abs
ARXIV_PAPER_PDF_BASE_URL=https://arxiv.org/pdf

# Frontend Configuration
APP_API_BASE_URL=http://localhost:8080
APP_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
